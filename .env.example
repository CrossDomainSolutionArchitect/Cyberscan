# CyberScan EmailJS configuration (Vite)
# Set these in your local .env file and in the GitHub Actions build environment.
# EmailJS Public Key is a client-side identifier, NOT a secret.
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Template variables in EmailJS:
# {{name}} {{time}} {{message}}
# Optional: {{email}} {{reply_to}} {{subject}}
# Configure Reply-To as {{reply_to}} and To Email as your verified CyberScan inbox.
# Do not put private email provider passwords or private API keys in VITE_ variables.
